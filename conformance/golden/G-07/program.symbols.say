module binary-search
edition 0
needs console


def find(target: Number, xs: List[Number]) -> Integer:
    var low = 1
    var high = count(xs)
    while low <= high:
        let middle = (low + high) // 2
        let value = xs[middle]
        if value = target:
            return middle
        elif value < target:
            low := middle + 1
        else:
            high := middle - 1
    return 0


def main() needs console:
    let xs = [2, 3, 5, 7, 11, 13, 17]
    show(find(11, xs))
    show(find(2, xs))
    show(find(4, xs))
