module prelude-test
edition 0


check "comparisons":
    check 1 <= 1
    check !(2 <= 1)
    check 2 > 1
    check 2 >= 2
    check 1 <= 2 <= 3
    check !(1 <= 3 < 3)
    check 1 <= 1 < 3
    check !(1 < 1 < 3)


check "numbers":
    check absolute(-3) = 3
    check absolute(2.5) = 2.5
    check checked_divide(1, by=4) = 0.25
    check checked_divide(1, by=0) fails division-by-zero
    check sum([]) = 0
    check sum([1, 2.50]) = 3.5


check "collections":
    check join_all(["a", "b"], ", ") = "a, b"
    check join_all([], ", ") = ""
    check map([1, 2], it => it * 2) = [2, 4]
    check map({1, 2}, it => it * 0) = {0}
    check filter([1, 2, 3], it => it > 1) = [2, 3]
    check sort([3, 1, 2]) = [1, 2, 3]
    check first([7, 8]) = 7
    check first([]) = nothing
    check last([7, 8]) = 8
    check take(2, from=[1, 2, 3]) = [1, 2]
    check take(5, from=[1]) = [1]
    check drop(2, from=[1, 2, 3]) = [3]
    check group_by(["ab", "b"], it => count(it)) = {2: ["ab"], 1: ["b"]}
    check count(zip([1, 2, 3], ["a", "b"])) = 2
    check zip([1], ["a"])[1].right = "a"
    check is_empty([])
    check !is_empty([1])
    check reversed([1, 2, 3]) = [3, 2, 1]
    check largest([2, 9, 4]) = 9
    check smallest([2, 9, 4]) = 2
    check largest([]) = nothing
